#
# cp .env.example .env and fill in every value. The passwords are read once
# on the first start; changing them later needs the matching service changed.

# image tag to run, required: the release you run, X.DD.MM.YYYY as in its VERSION file
ULRMM_VERSION=
# API name, the agents and the dashboard talk to it
API_DOMAIN=api.example.com
# dashboard name
APP_DOMAIN=rmm.example.com
# MeshCentral name
MESH_DOMAIN=mesh.example.com
# root domain of the three names; subject of the self-signed certificate
ROOT_DOMAIN=example.com
# e-mail of the dashboard superuser and the MeshCentral account
ADMIN_EMAIL=admin@example.com
# dashboard superuser, created on the first start only
ADMIN_USER=admin
# password of that superuser, read on the first start only; empty afterwards is fine
ADMIN_PASSWORD=
# password of the postgres role ulrmm (database ulrmm)
POSTGRES_PASSWORD=
# redis requirepass
REDIS_PASSWORD=
# password of the postgres role meshcentral (database meshcentral)
MESH_DB_PASSWORD=
# MeshCentral account the server logs in with
MESH_USERNAME=ulrmm-mesh
# password of that account, created on the first start
MESH_PASSWORD=
# own: mount fullchain.pem and privkey.pem into /certs; selfsigned: nginx makes a wildcard cert
ULRMM_TLS=own
# published ports of nginx
HTTP_PORT=80
HTTPS_PORT=443
# uwsgi worker processes of the api service
UWSGI_WORKERS=6
# log level of the Django services (stdout)
ULRMM_LOG_LEVEL=INFO
# dashboard source built into the nginx image (build only, not for pulled images);
# the default repo needs access: token below, or a reachable mirror
ULRMM_WEB_REPO=https://github.com/RiDDiX/ulrmm-web.git
ULRMM_WEB_REF=main
# token for ULRMM_WEB_REPO, passed to the build as a BuildKit secret; empty for anonymous
ULRMM_WEB_TOKEN=
# script library, cloned by init into the scripts-lib volume (ULRMM_SCRIPTS_GIT_URL in local_settings.py);
# the default repo needs access, init only warns when the clone fails
ULRMM_SCRIPTS_REPO=https://github.com/RiDDiX/ulrmm-scripts.git
# token for ULRMM_SCRIPTS_REPO, used by init through GIT_ASKPASS; empty for anonymous
ULRMM_SCRIPTS_TOKEN=
# agent source for docker compose run --rm agents (ULRMM_AGENT_GIT_URL in local_settings.py);
# the default repo needs access: set ULRMM_GIT_TOKEN in local_settings.py or use a reachable mirror
ULRMM_AGENT_REPO=https://github.com/RiDDiX/ulrmm-agent.git
# time zone of every container
TZ=UTC
